{
  "name": "lift-dash",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit --incremental false",
    "test": "vitest --pool=threads",
    "test:run": "vitest run --pool=threads",
    "test:coverage": "vitest run --pool=threads --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.85.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "1.31.0",
    "next": "15.5.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.81.0",
    "recharts": "3.4.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "16.2.7",
    "postcss": "8.5.26",
    "prettier": "3.7.4",
    "tailwindcss": "3.4.18",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bunx eslint --fix --max-warnings=0",
      "bunx prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "bunx prettier --write"
    ]
  },
  "patchedDependencies": {
    "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch"
  }
}
